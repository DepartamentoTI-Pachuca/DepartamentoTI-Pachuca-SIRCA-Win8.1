<Window x:Class="PoderJudicial.Views.ConsolidarEtiqueta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consolidar etiqueta"
        Height="500"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Margin="10"
            CornerRadius="8"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="8"
                              Opacity=".35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">

                <Grid>
                    <TextBlock Text="Consolidar etiqueta - Seleccionar PowerPoint existente"
                               Margin="16,0,48,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Semibold"
                               FontSize="14.5"/>

                    <Button Content="✕"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BtnCancelar_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="18,14">

                <TextBlock Text="Selecciona el PowerPoint existente al que deseas agregar la(s) etiqueta(s)."
                           FontSize="12"
                           Foreground="#3569C9"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Archivo de etiqueta nueva (generada)"
                           FontFamily="Segoe UI Semibold"
                           FontSize="12.5"
                           Margin="0,0,0,6"/>

                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="11"
                        Margin="0,0,0,14">

                    <StackPanel>
                        <TextBlock x:Name="TxtNombreOrigen"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="12.5"/>

                        <TextBlock x:Name="TxtRutaOrigen"
                                   Margin="0,3,0,0"
                                   FontSize="10.8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Buscar PowerPoint existente:"
                           FontFamily="Segoe UI Semibold"
                           FontSize="12.5"
                           Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="86"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtRutaDestino"
                             Height="36"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Padding="8,0"/>

                    <Button Grid.Column="2"
                            Content="Buscar..."
                            Height="36"
                            Click="BtnBuscar_Click"/>
                </Grid>

                <TextBlock Text="Archivo seleccionado:"
                           FontFamily="Segoe UI Semibold"
                           FontSize="12.5"
                           Margin="0,0,0,6"/>

                <Border x:Name="PanelArchivoSeleccionado"
                        BorderBrush="#9BC1FF"
                        BorderThickness="1"
                        Background="#F6F9FF"
                        CornerRadius="5"
                        Padding="11"
                        Visibility="Collapsed">

                    <StackPanel>
                        <TextBlock x:Name="TxtNombreDestino"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="12.5"/>

                        <TextBlock x:Name="TxtRutaDestinoDetalle"
                                   Margin="0,3,0,0"
                                   FontSize="10.8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TxtFechaDestino"
                                   Margin="0,5,0,0"
                                   FontSize="10.8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">

                    <Button Content="Cancelar"
                            Width="90"
                            Height="36"
                            Margin="0,0,10,0"
                            Click="BtnCancelar_Click"/>

                    <Button x:Name="BtnSiguiente"
                            Content="Siguiente"
                            Width="96"
                            Height="36"
                            IsEnabled="False"
                            Background="#1264D8"
                            Foreground="White"
                            Click="BtnSiguiente_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
