<Window x:Class="PoderJudicial.Views.Etiquetas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etiquetas"
        Height="520"
        Width="455"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Margin="10"
            CornerRadius="8"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="8"
                              Opacity=".35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">

                <Grid>
                    <TextBlock x:Name="TxtTitulo"
                               Margin="18,0,52,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Semibold"
                               FontSize="16"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <Button Content="✕"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnCerrar_Click"/>
                </Grid>
            </Border>

            <!-- CONTENIDO -->
            <Grid Grid.Row="1"
                  Margin="18,14,18,12">

                <!-- ESTADO INICIAL -->
                <StackPanel x:Name="PanelSinEtiqueta">

                    <Border Background="#F4F8FF"
                            BorderBrush="#AFCBFA"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,0,0,14">

                        <TextBlock Text="ⓘ  Aquí puedes generar una nueva etiqueta. Después de crearla se abrirá en PowerPoint para completar la información faltante."
                                   TextWrapping="Wrap"
                                   FontSize="12.5"
                                   Foreground="#3569C9"/>
                    </Border>

                    <TextBlock Text="Estado actual"
                               FontFamily="Segoe UI Semibold"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="▱"
                                       FontSize="42"
                                       Foreground="#9AA3AF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="No hay etiqueta generada."
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="13.5"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,4"/>

                            <TextBlock Text="Genera una nueva etiqueta para este registro."
                                       FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,18"/>

                            <Button Content="⊕  Generar etiqueta"
                                    Width="245"
                                    Height="42"
                                    Background="#1264D8"
                                    Foreground="White"
                                    FontFamily="Segoe UI Semibold"
                                    HorizontalAlignment="Center"
                                    Click="BtnGenerarEtiqueta_Click"/>

                            <Button Content="▧  Consolidar etiqueta"
                                    Width="245"
                                    Height="40"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ETIQUETA YA GENERADA -->
                <StackPanel x:Name="PanelEtiquetaGenerada"
                            Visibility="Collapsed">

                    <Border x:Name="BorderMensajeEstado"
                            Background="#F0FBF4"
                            BorderBrush="#A9E0BA"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,0,0,12">

                        <StackPanel>
                            <TextBlock x:Name="TxtMensajePrincipal"
                                       Text="✓  Etiqueta generada correctamente."
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="12.5"
                                       Foreground="#21824A"/>

                            <TextBlock x:Name="TxtMensajeSecundario"
                                       Text="Se abrió el archivo en PowerPoint. Completa la información faltante y guarda los cambios."
                                       Margin="24,5,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="11.8"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Etiqueta generada"
                               FontFamily="Segoe UI Semibold"
                               FontSize="13.5"
                               Margin="0,0,0,7"/>

                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,0,0,12">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="▣"
                                       FontSize="27"
                                       Foreground="#E34B25"
                                       VerticalAlignment="Top"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TxtNombreArchivo"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="12.5"/>

                                <TextBlock x:Name="TxtRutaArchivo"
                                           FontSize="10.8"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                                <TextBlock x:Name="TxtFechaArchivo"
                                           FontSize="10.8"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Estado"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="12.5"/>

                        <StackPanel Grid.Column="1">
                            <Border x:Name="BadgeEstado"
                                    Background="#FFF6D8"
                                    BorderBrush="#F0D47D"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="7,3"
                                    HorizontalAlignment="Left">

                                <TextBlock x:Name="TxtEstado"
                                           Text="Pendiente de guardar"
                                           FontSize="11.2"
                                           Foreground="#806213"/>
                            </Border>

                            <TextBlock x:Name="TxtAyudaEstado"
                                       Text="Guarda el archivo en PowerPoint para poder consolidarlo."
                                       Margin="0,6,0,0"
                                       FontSize="11.4"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="▱  Abrir etiqueta"
                                Height="38"
                                Click="BtnAbrirEtiqueta_Click"/>

                        <Button x:Name="BtnGuardarPrimeraEtiqueta"
                                Grid.Column="2"
                                Content="Guardar primera"
                                ToolTip="Guardar primera etiqueta"
                                FontSize="11"
                                Height="38"
                                IsEnabled="False"
                                Click="BtnGuardarPrimeraEtiqueta_Click"/>

                        <Button x:Name="BtnConsolidarEtiqueta"
                                Grid.Column="4"
                                Content="▧  Consolidar etiqueta"
                                FontSize="11"
                                Height="38"
                                IsEnabled="False"
                                Click="BtnConsolidarEtiqueta_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">

                <Grid Margin="0,10,12,10">
                    <Button Content="Cerrar"
                            Width="78"
                            Height="34"
                            HorizontalAlignment="Right"
                            Click="BtnCerrar_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
