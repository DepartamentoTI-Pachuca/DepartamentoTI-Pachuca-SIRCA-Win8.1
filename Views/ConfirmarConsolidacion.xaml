<Window x:Class="PoderJudicial.Views.ConfirmarConsolidacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consolidar etiqueta - Confirmar"
        Height="380"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Margin="10"
            CornerRadius="8"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="8"
                              Opacity=".35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">

                <Grid>
                    <TextBlock Text="Consolidar etiqueta - Confirmar"
                               Margin="16,0,48,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Semibold"
                               FontSize="15"/>

                    <Button Content="✕"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BtnCancelar_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="18,14">

                <Border Background="#FFF9EA"
                        BorderBrush="#F0D487"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="11"
                        Margin="0,0,0,12">

                    <TextBlock Text="⚠  Se agregarán las diapositivas de la etiqueta al siguiente archivo. El archivo original no se eliminará; se actualizará con las nuevas etiquetas."
                               TextWrapping="Wrap"
                               FontSize="11.8"
                               Foreground="#6D5512"/>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12"
                        Margin="0,0,0,12">

                    <StackPanel>
                        <TextBlock x:Name="TxtNombreDestino"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="13"/>

                        <TextBlock x:Name="TxtRutaDestino"
                                   Margin="0,4,0,0"
                                   FontSize="10.8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TxtFechaDestino"
                                   Margin="0,5,0,0"
                                   FontSize="10.8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="#F4F8FF"
                        BorderBrush="#AFCBFA"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="11">

                    <TextBlock Text="ⓘ  Se recomienda que el archivo no esté abierto en PowerPoint durante el proceso de consolidación."
                               TextWrapping="Wrap"
                               FontSize="11.5"
                               Foreground="#3569C9"/>
                </Border>
            </StackPanel>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">

                    <Button Content="Cancelar"
                            Width="90"
                            Height="36"
                            Margin="0,0,10,0"
                            Click="BtnCancelar_Click"/>

                    <Button Content="✓  Consolidar"
                            Width="112"
                            Height="36"
                            Background="#1264D8"
                            Foreground="White"
                            Click="BtnConsolidar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
