<Page x:Class="PoderJudicial.Views.ConsultarRegistros"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{DynamicResource BackgroundBrush}">


    <Page.Resources>

        <!-- TextBlock -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- badge -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Botones acción -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">

            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background"
            Value="{DynamicResource ActionButtonBackgroundBrush}"/>
            <Setter Property="Foreground"
            Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="btn"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="btn"
                                Property="Background"
                                Value="{DynamicResource ActionButtonHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="btn"
                                Property="Opacity"
                                Value="0.8"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- BOTÓN PRINCIPAL -->
                            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- TEXTO -->
                                    <TextBlock Text="{TemplateBinding SelectionBoxItem}"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <!-- FLECHA -->
                                    <TextBlock Grid.Column="1"
                               Text="▼"
                               FontSize="10"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>


                                    <!-- BOTÓN -->
                                    <ToggleButton Grid.ColumnSpan="2"
                               Background="Transparent"
                               BorderThickness="0"
                               Focusable="False"
                               IsChecked="{Binding IsDropDownOpen,
                               RelativeSource={RelativeSource TemplatedParent},
                               Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>

                            </Border>

                            <!-- POPUP -->
                            <Popup x:Name="Popup"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   PopupAnimation="Slide">

                                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,4,0,0">

                                    <ScrollViewer MaxHeight="250">

                                        <StackPanel IsItemsHost="True"/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush"
    Value="{DynamicResource BorderBrush}"/>
                            </Trigger>


                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border"
                        Property="BorderBrush"
                        Value="#2ECC8F"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush"
    Value="{DynamicResource BorderBrush}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ── Estilo base TextBox ── -->
        <Style x:Key="InputStyle" TargetType="TextBox">

            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8"
                Padding="{TemplateBinding Padding}">

                            <ScrollViewer x:Name="PART_ContentHost"
                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush"
                        Value="#2ECC8F"/>

                                <Setter Property="Background"
                        Value="{DynamicResource HoverBrush}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


    </Page.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CONSULTAR REGISTROS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TituloTabla}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding NombreTablaActual, StringFormat=Tabla actual: {0}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,3,0,0"/>
                    <TextBlock Text="Bienvenido, Admin Sistema. Visualiza y gestiona los registros."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <!-- Hora desde ViewModel -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Hora}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="{Binding Fecha}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- contenido -->
        <Grid Grid.Row="1" Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BUSCADOR -->
            <Grid Grid.Row="0" Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="550"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="42">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="⌕"
                                   FontSize="14"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Grid Grid.Column="1">
                            <TextBox x:Name="txtBuscar"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Foreground="{DynamicResource InputTextBrush}"
                                     CaretBrush="{DynamicResource PrimaryTextBrush}"
                                     VerticalContentAlignment="Center"
                                     Padding="0,0,10,0"
                                     TextChanged="txtBuscar_TextChanged"
                                     KeyUp="txtBuscar_KeyUp"
                                     GotFocus="txtBuscar_GotFocus"
                                     LostFocus="txtBuscar_LostFocus"/>

                            <Popup x:Name="popupSugerencias"
                                   PlacementTarget="{Binding ElementName=txtBuscar}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Width="360"
                                        MaxHeight="220">
                                    <ListBox x:Name="lstSugerencias"
                                             Background="{DynamicResource CardBrush}"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             BorderThickness="0"
                                             FontSize="13"
                                             MouseUp="lstSugerencias_MouseUp"
                                             KeyDown="lstSugerencias_KeyDown">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">

                                                <Setter Property="Padding" Value="10"/>
                                                <Setter Property="Cursor" Value="Hand"/>

                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource HoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>

                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <!-- FILTROS AVANZADOS (toggle) -->
                <Button x:Name="BtnFiltrosAvanzados"
                        Content="Filtros avanzados ▾"
                        Grid.Column="1"
                        Height="42"
                        Width="160"
                        Padding="14,0"
                        Margin="10,0"
                        Cursor="Hand"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Click="BtnFiltrosAvanzados_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#2ECC8F"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- TOTALES -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="BtnActualizar"
                            Content="↻  Actualizar"
                            Height="36"
                            Padding="14,0"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Background="{DynamicResource InputBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Click="BtnActualizar_Click"/>

                    <!-- TOTAL REGISTROS -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="14,7"
                            Margin="0,0,10,0">

                        <TextBlock Text="{Binding TotalRegistros}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Border>

                    <!-- TOTAL DISCOS -->
                    <Border Background="{DynamicResource ReportBlueSurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="14,7">

                        <TextBlock Text="{Binding TotalDiscosBusqueda}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ReportBlueAccentBrush}"/>
                    </Border>

                </StackPanel>
            </Grid>

            <!-- PANEL DE FILTROS AVANZADOS (colapsado por defecto) -->
            <Border x:Name="PanelFiltrosAvanzados"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16"
                    Margin="0,0,0,20">

                <Border.Resources>
                    
                    
                    <Style x:Key="FiltroDateStyle" TargetType="DatePicker">
                        <Setter Property="Height" Value="34"/>
                        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    
                </Border.Resources>

                <StackPanel>

                    <WrapPanel Orientation="Horizontal">

                        <!-- NUC -->
                                <StackPanel x:Name="PanelFiltroNUC" Width="160" Margin="0,0,30,12">
                                    <TextBlock Text="NUC" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding FiltroNUC, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <!-- No. Causa -->
                                <StackPanel x:Name="PanelFiltroNoCausa" Width="160" Margin="0,0,30,12">
                                    <TextBlock Text="No. Causa" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding FiltroNoCausa, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <!-- Tipo Causa -->
                                <StackPanel x:Name="PanelFiltroTipoCausa" Width="130" Margin="0,0,30,12">
                                    <TextBlock Text="Tipo Causa" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox Style="{StaticResource ComboStyle}"
                                      ItemsSource="{Binding TiposCausaDisponibles}"
                                      SelectedItem="{Binding FiltroTipoCausa}"
                                      IsEditable="False"/>
                                </StackPanel>

                                <!-- Fecha desde -->
                        <StackPanel x:Name="PanelFiltroFechaDesde" Width="150" Margin="0,0,14,12">
                            <TextBlock Text="Fecha audiencia — desde" Style="{StaticResource LabelStyle}"/>
                            <DatePicker Style="{StaticResource FiltroDateStyle}"
                                        SelectedDate="{Binding FiltroFechaDesde}"/>
                        </StackPanel>

                        <!-- Fecha hasta -->
                        <StackPanel x:Name="PanelFiltroFechaHasta" Width="150" Margin="0,0,14,12">
                            <TextBlock Text="Fecha audiencia — hasta" Style="{StaticResource LabelStyle}"/>
                            <DatePicker Style="{StaticResource FiltroDateStyle}"
                                        SelectedDate="{Binding FiltroFechaHasta}"/>
                        </StackPanel>

                        <!-- Fecha Recibo (solo Registro de Copias: ahí es lo
                             que realmente indica cuándo se entregó la copia,
                             a diferencia de Fecha Audiencia) -->
                        <StackPanel x:Name="PanelFiltroFechaReciboDesde" Width="150" Margin="0,0,14,12">
                            <TextBlock Text="Fecha recibo — desde" Style="{StaticResource LabelStyle}"/>
                            <DatePicker Style="{StaticResource FiltroDateStyle}"
                                        SelectedDate="{Binding FiltroFechaReciboDesde}"/>
                        </StackPanel>

                        <StackPanel x:Name="PanelFiltroFechaReciboHasta" Width="150" Margin="0,0,14,12">
                            <TextBlock Text="Fecha recibo — hasta" Style="{StaticResource LabelStyle}"/>
                            <DatePicker Style="{StaticResource FiltroDateStyle}"
                                        SelectedDate="{Binding FiltroFechaReciboHasta}"/>
                        </StackPanel>

                        <!-- Juzgado -->
                        <StackPanel x:Name="PanelFiltroJuzgado" Width="140" Margin="0,0,14,12">
                            <TextBlock Text="Juzgado" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Style="{StaticResource ComboStyle}"
                                      ItemsSource="{Binding JuzgadosDisponibles}"
                                      SelectedItem="{Binding FiltroJuzgado}"
                                      IsEditable="False"/>
                        </StackPanel>

                        <!-- Sala -->
                        <StackPanel x:Name="PanelFiltroSala" Width="110" Margin="0,0,14,12">
                            <TextBlock Text="Sala" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Style="{StaticResource ComboStyle}"
                                      ItemsSource="{Binding SalasDisponibles}"
                                      SelectedItem="{Binding FiltroSala}"
                                      IsEditable="False"/>
                        </StackPanel>

                        <!-- Juez -->
                        <StackPanel x:Name="PanelFiltroJuez" Width="170" Margin="0,0,14,12">
                            <TextBlock Text="Juez" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding FiltroJuez, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Imputado -->
                        <StackPanel x:Name="PanelFiltroImputado" Width="170" Margin="0,0,14,12">
                            <TextBlock Text="Imputado" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding FiltroImputado, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Delito -->
                        <StackPanel x:Name="PanelFiltroDelito" Width="170" Margin="0,0,14,12">
                            <TextBlock Text="Delito" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding FiltroDelito, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Expediente (solo Ejecución) -->
                        <StackPanel x:Name="PanelFiltroExpediente" Width="170" Margin="0,0,14,12">
                            <TextBlock Text="Expediente" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding FiltroExpediente, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- A Quien se Entrega (solo Copias) -->
                        <StackPanel x:Name="PanelFiltroAQuienEntrega" Width="190" Margin="0,0,14,12">
                            <TextBlock Text="A Quien se Entrega" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding FiltroAQuienEntrega, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                    </WrapPanel>

                    <!-- BOTONES -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Limpiar filtros"
                                Command="{Binding LimpiarFiltrosCommand}"
                                Height="34" Padding="14,0" Margin="0,0,10,0"
                                Cursor="Hand" FontSize="12.5"
                                Foreground="{DynamicResource PrimaryTextBrush}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="Buscar"
                                Command="{Binding BuscarAvanzadoCommand}"
                                Height="34" Width="110"
                                Cursor="Hand" FontSize="12.5" FontWeight="SemiBold"
                                Foreground="White">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#2ECC8F" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- TABLA -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    ClipToBounds="True">

                <DataGrid x:Name="dgAudiencias"
                          ItemsSource="{Binding Audiencias}"
                          AutoGenerateColumns="False"
                          FrozenColumnCount="1"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="{DynamicResource CardBrush}"
                          RowBackground="{DynamicResource CardBrush}"
                          AlternatingRowBackground="{DynamicResource AltRowBrush}"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          CanUserResizeRows="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          IsReadOnly="True"
                          RowHeight="56"
                          ColumnHeaderHeight="52"
                          FontSize="13"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                    <!-- ═══ ESTILOS INTERNOS ═══ -->
                    <DataGrid.Resources>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                        <Style x:Key="ColumnaAccionesStyle" TargetType="DataGridCell">
                            <Setter Property="Background" Value="{DynamicResource ActionColumnBrush}"/>
                            <!-- Línea divisora -->
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,2,0"/>
                            <Setter Property="Padding" Value="10,0"/>
                        </Style>

                        <!-- Texto centrado -->
                        <Style x:Key="CenteredCellText" TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>

                    </DataGrid.Resources>

                    <!-- HEADER STYLE -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">

                            <Setter Property="Background"
                                    Value="{DynamicResource HeaderBrush}"/>

                            <Setter Property="Foreground"
                                    Value="{DynamicResource PrimaryTextBrush}"/>

                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource BorderBrush}"/>

                            <Setter Property="BorderThickness"
                                    Value="0,0,0,1"/>

                            <Setter Property="HorizontalContentAlignment" Value="Center"/>

                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- ROW STYLE -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">

                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource BorderBrush}"/>

                            <Setter Property="BorderThickness"
                                    Value="0,0,0,1"/>

                            <Style.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter Property="Background"
                                            Value="{DynamicResource HoverBrush}"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness"   Value="0"/>
                            <Setter Property="Padding"           Value="12,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource TableRowBrush}"/>
                            <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <!-- Corrige orientación de todas las celdas -->
                            <Setter Property="FlowDirection"     Value="LeftToRight"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">

                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>

                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>

                                </Trigger>
                            </Style.Triggers>
                        </Style>



                    </DataGrid.CellStyle>

                    <!-- ═══ COLUMNAS ═══ -->
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Acciones"
                            Width="120"
                            CanUserSort="False"
                            CellStyle="{StaticResource ColumnaAccionesStyle}">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                                        <Button Style="{StaticResource ActionBtnStyle}"
                            ToolTip="Ver detalle"
                            Command="{Binding DataContext.VerCommand,
                            RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}">

                                            <TextBlock Text="👁" FontSize="15"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Button>

                                        <Button Style="{StaticResource ActionBtnStyle}"
                            ToolTip="Editar"
                            Command="{Binding DataContext.EditarCommand,
                            RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}">

                                            <TextBlock Text="✏" FontSize="15"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Button>

