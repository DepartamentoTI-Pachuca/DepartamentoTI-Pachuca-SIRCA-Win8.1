<Window x:Class="PoderJudicial.Views.ConsolidacionCompletadaEjecucion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consolidación completada"
        Height="310"
        Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Margin="10"
            CornerRadius="8"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="8"
                              Opacity=".35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Consolidación completada"
                               Margin="16,0,48,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Semibold"
                               FontSize="15"/>

                    <Button Content="✕"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="BtnCerrar_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="18,14">

                <Border Background="#F0FBF4"
                        BorderBrush="#A9E0BA"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="11"
                        Margin="0,0,0,12">
                    <TextBlock Text="✓ Las etiquetas se agregaron correctamente al PowerPoint."
                               FontFamily="Segoe UI Semibold"
                               FontSize="12"
                               Foreground="#21824A"/>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="TxtNombreArchivo"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="13"/>

                        <TextBlock x:Name="TxtRutaArchivo"
                                   Margin="0,4,0,0"
                                   FontSize="10.8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TxtFechaArchivo"
                                   Margin="0,6,0,0"
                                   FontSize="10.8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="0,10,12,10">
                    <Button Content="Cerrar"
                            Width="78"
                            Height="34"
                            HorizontalAlignment="Right"
                            Click="BtnCerrar_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
